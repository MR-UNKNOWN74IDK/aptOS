#!/usr/bin/env bash
#
# aptOS - apt-syntax package management for pacman, with automatic AUR support
#
# Usage: apt <command> [options] [packages]
#
# Ship this file as `aptOS`, then symlink it as `apt` (and optionally
# `apt-get`) so it's invoked exactly like real apt:
#   sudo ln -s /usr/local/bin/aptOS /usr/local/bin/apt
#
# Combines:
#   - aptpac's AUR helper auto-detection (yay/paru/pikaur/etc.)
#   - AptArch's clean colorized UX and explicit "unsupported feature" messages
#   - additional apt option/command coverage found missing in both
#
# Copyright (C) 2026 MR_UNKNOWN74IDK <mr.unknown74idk@proton.me>
# License: AGPLv3 (see LICENSE)

set -uo pipefail

VERSION="1.0.3"
PACMAN_BIN="pacman"
PACMAN_CONFIG="/etc/pacman.conf"

# ---------------------------------------------------------------------------
# Colors
# ---------------------------------------------------------------------------
USE_COLOR=true
[[ -t 1 ]] || USE_COLOR=false
[[ -n "${NO_COLOR:-}" ]] && USE_COLOR=false

RESET=$'\x1b[0m'; RED=$'\x1b[31m'; GREEN=$'\x1b[32m'
YELLOW=$'\x1b[33m'; CYAN=$'\x1b[36m'; PURPLE=$'\x1b[35m'

clr()  { $USE_COLOR && printf '%s%s%s' "$2" "$1" "$RESET" || printf '%s' "$1"; }
err()  { echo "$(clr "E: $*" "$RED")" >&2; }
warn() { echo "$(clr "W: $*" "$YELLOW")" >&2; }
info() { echo "$(clr "$*" "$CYAN")"; }
ok()   { echo "$(clr "$*" "$GREEN")"; }
debug(){ $DEBUG && echo "$(clr "D: $*" "$PURPLE")" >&2; }

# ---------------------------------------------------------------------------
# State
# ---------------------------------------------------------------------------
DEBUG=false
YES=false
DOWNLOAD_ONLY=false
NO_UPGRADE=false
REINSTALL=false
PURGE=false
SIMULATE=false
AUR_HELPER_OVERRIDE=""
COMMAND=""
PACKAGES=()

HELPERS=(yay paru pikaur aurman pacaur aura trizen)
RUNNER="$PACMAN_BIN"

is_root() { [[ "${EUID:-$(id -u)}" -eq 0 ]]; }

require_pacman() {
    command -v "$PACMAN_BIN" >/dev/null 2>&1 || { err "'$PACMAN_BIN' not found. aptOS only runs on pacman-based systems (Arch, Manjaro, EndeavourOS, ...)."; exit 1; }
}

# ---------------------------------------------------------------------------
# Help
# ---------------------------------------------------------------------------
print_usage() {
cat <<EOF
aptOS ${VERSION} - apt commands for pacman, with automatic AUR support

Usage: apt [options] <command> [packages]

Commands:
    list [--installed|--upgradeable|--all-versions|<term>]
                                 List packages (default: all known, like real 'apt list')
    search                      Search for a package (repo + AUR if a helper is present)
    show, showpkg               Show package details
    install                     Install a package
    reinstall                   Reinstall a package (warns; pacman has no native reinstall)
    remove                      Remove a package (keeps now-unneeded deps; see autoremove)
    purge                       Remove a package + its saved config backups
    autoremove                  Remove orphaned dependencies
    update                      Refresh package databases
    upgrade                     Upgrade installed packages
    full-upgrade                Refresh + upgrade (sync databases, then upgrade)
    edit-sources                Edit pacman.conf in \$EDITOR, with a basic sanity check
    clean                       Clear the full package cache
    autoclean                   Clear old cached package versions only
    policy [pkg]                Show installed vs. candidate version + repo for a package
    build                       [aptOS extra, not apt] Build ./PKGBUILD (makepkg -sri)
    rdepends                    [aptOS extra, not apt] Show reverse dependencies (pactree)
    log [term]                  [aptOS extra, not apt] Tail /var/log/pacman.log (read-only)
    moo                         ???

Options:
    -y, --yes, --assume-yes     Do not prompt for confirmation
    -d, --download-only         Download packages without installing
    -s, --simulate, --dry-run   Show what would happen, change nothing
    -c, --config-file <file>    Use an alternate pacman.conf
        --no-upgrade            Do not upgrade already-installed packages (--needed)
        --reinstall             Force reinstall
        --purge                 Remove config files too (with 'remove')
        --aur-helper <name>     Force a specific AUR helper (or plain pacman)
        --no-color              Disable colored output
        --color                 Force colored output
        --debug                 Verbose internal logging
    -h, --help                  Show this help
    -v, --version                Show version info

Ignored for apt compatibility (accepted, no effect on pacman):
    -o, --option <k=v>          apt config override
        --cli-version            request a specific apt CLI version
        --audit                  show audit info

Notes:
    - When run as a normal user, aptOS auto-detects an installed AUR helper
      (yay, paru, pikaur, aurman, pacaur, aura, trizen) and uses it instead of
      pacman, so 'install'/'search'/'show' etc. also reach the AUR.
    - When run with sudo, or as root, aptOS always falls back to plain pacman,
      because AUR helpers refuse to run as root.

Real apt features with no pacman equivalent (nothing to build here, just flagged):
    changelog        - pacman tracks no changelog data at all; use 'asp log <pkg>' (AUR)
    source           - use the ABS (Arch Build System) or 'asp' to fetch build sources
    satisfy          - pacman has no arbitrary dependency-string solver
    --fix-broken     - pacman is transactional and auto-rolls-back; nothing to fix
    --no-install-recommends
                     - pacman/PKGBUILDs have no concept of recommended-vs-required deps
    -t, --target-release
                     - Arch is a rolling release; there is no release/suite pinning
Note: 'why'/'why-not' are aptitude commands, and 'history-*' are DNF commands —
neither is real apt, so they aren't emulated here. See 'rdepends' and 'log' instead.
EOF
}

print_version() {
    echo "aptOS ${VERSION}"
    "$PACMAN_BIN" --version | head -3
    for h in "${HELPERS[@]}"; do
        command -v "$h" >/dev/null 2>&1 && echo "AUR helper available: $h"
    done
}

unsupported() {
    local feature="$1" reason="$2"
    err "'$feature' is not supported."
    echo "    $reason" >&2
}

# ---------------------------------------------------------------------------
# AUR helper detection (aptpac-style)
# ---------------------------------------------------------------------------
detect_runner() {
    if [[ -n "$AUR_HELPER_OVERRIDE" ]]; then
        if command -v "$AUR_HELPER_OVERRIDE" >/dev/null 2>&1; then
            RUNNER="$AUR_HELPER_OVERRIDE"
        else
            err "specified helper '$AUR_HELPER_OVERRIDE' is not installed"
            exit 1
        fi
        return
    fi

    if is_root; then
        RUNNER="$PACMAN_BIN"
        return
    fi

    for h in "${HELPERS[@]}"; do
        if command -v "$h" >/dev/null 2>&1; then
            RUNNER="$h"
            debug "using AUR helper: $h"
            return
        fi
    done

    RUNNER="$PACMAN_BIN"
    debug "no AUR helper found, using pacman"
}

# Run a privileged pacman/helper operation, adding sudo only for plain pacman
run_pm() {
    if $SIMULATE; then
        info "[simulate] ${RUNNER} $*"
        return 0
    fi
    if [[ "$RUNNER" == "$PACMAN_BIN" ]] && ! is_root; then
        sudo "$PACMAN_BIN" --config "$PACMAN_CONFIG" "$@"
    else
        "$RUNNER" "$@"
    fi
}

# Run a read-only query (search/show/list) — never needs sudo, never simulated
query_pm() {
    "$RUNNER" "$@"
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------
if [[ $# -eq 0 ]]; then
    print_usage
    exit 1
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) print_usage; exit 0 ;;
        -v|--version) print_version; exit 0 ;;
        -y|--yes|--assume-yes) YES=true ;;
        -d|--download-only) DOWNLOAD_ONLY=true ;;
        -s|--simulate|--dry-run) SIMULATE=true ;;
        -c|--config-file)
            shift
            PACMAN_CONFIG="${1:-}"
            [[ -z "$PACMAN_CONFIG" ]] && { err "-c/--config-file requires an argument"; exit 1; }
            ;;
        --no-upgrade) NO_UPGRADE=true ;;
        --reinstall) REINSTALL=true ;;
        --purge) PURGE=true ;;
        --no-color) USE_COLOR=false ;;
        --color) USE_COLOR=true ;;
        --debug) DEBUG=true ;;
        --aur-helper)
            shift
            AUR_HELPER_OVERRIDE="${1:-}"
            [[ -z "$AUR_HELPER_OVERRIDE" ]] && { err "--aur-helper requires an argument"; exit 1; }
            ;;
        -o|--option) shift ;; # accepted for apt compatibility, ignored
        --cli-version) shift ;; # accepted, ignored
        --audit) ;; # accepted, ignored
        --fix-broken)
            unsupported "--fix-broken" "pacman auto-rolls-back failed transactions; nothing to fix."
            exit 1
            ;;
        --no-install-recommends)
            unsupported "--no-install-recommends" "pacman has no concept of recommended vs. required dependencies."
            exit 1
            ;;
        -t|--target-release)
            shift
            unsupported "-t/--target-release" "Arch is a rolling release; there is no release pinning."
            exit 1
            ;;
        -*)
            warn "unknown option '$1' (ignored)"
            ;;
        *)
            if [[ -z "$COMMAND" ]]; then
                COMMAND="$1"
            else
                PACKAGES+=("$1")
            fi
            ;;
    esac
    shift
done

if [[ -z "$COMMAND" ]]; then
    print_usage
    exit 1
fi

if [[ "$COMMAND" != "moo" ]]; then
    require_pacman
    detect_runner
fi

if [[ "$RUNNER" != "$PACMAN_BIN" ]] && is_root; then
    warn "running as root: AUR helper '$RUNNER' will likely refuse to run. Falling back to pacman."
    RUNNER="$PACMAN_BIN"
fi

# ---------------------------------------------------------------------------
# Command dispatch
# ---------------------------------------------------------------------------
case "$COMMAND" in
    list)
        if [[ ${#PACKAGES[@]} -eq 0 ]]; then
            query_pm -Sl
        else
            case "${PACKAGES[0]}" in
                --installed) query_pm -Q ;;
                --upgradeable|--upgradable) query_pm -Qu ;;
                --all-versions) query_pm -Sl ;;
                *) query_pm -Sl | grep -i -- "${PACKAGES[0]}" ;;
            esac
        fi
        ;;

    search)
        [[ ${#PACKAGES[@]} -eq 0 ]] && { err "search requires a search term"; exit 1; }
        query_pm -Ss "${PACKAGES[@]}"
        ;;

    show|showpkg)
        [[ ${#PACKAGES[@]} -eq 0 ]] && { err "show requires a package name"; exit 1; }
        query_pm -Qi "${PACKAGES[@]}" 2>/dev/null || query_pm -Si "${PACKAGES[@]}"
        ;;

    install)
        [[ ${#PACKAGES[@]} -eq 0 ]] && { err "install requires at least one package"; exit 1; }
        opts=(-S)
        $YES && opts+=(--noconfirm)
        $DOWNLOAD_ONLY && opts+=(-w)
        $NO_UPGRADE && opts+=(--needed)
        run_pm "${opts[@]}" "${PACKAGES[@]}"
        ;;

    reinstall)
        [[ ${#PACKAGES[@]} -eq 0 ]] && { err "reinstall requires at least one package"; exit 1; }
        warn "pacman has no native reinstall; forcing a fresh install of the current version"
        opts=(-S)
        $YES && opts+=(--noconfirm)
        run_pm "${opts[@]}" "${PACKAGES[@]}"
        ;;

    remove)
        [[ ${#PACKAGES[@]} -eq 0 ]] && { err "remove requires at least one package"; exit 1; }
        $PURGE && opts=(-Rn) || opts=(-R)
        $YES && opts+=(--noconfirm)
        run_pm "${opts[@]}" "${PACKAGES[@]}"
        ;;

    purge)
        [[ ${#PACKAGES[@]} -eq 0 ]] && { err "purge requires at least one package"; exit 1; }
        opts=(-Rn)
        $YES && opts+=(--noconfirm)
        run_pm "${opts[@]}" "${PACKAGES[@]}"
        ;;

    autoremove)
        mapfile -t orphans < <(pacman -Qdtq 2>/dev/null)
        if [[ ${#orphans[@]} -eq 0 ]]; then
            ok "no orphaned packages to remove"
        else
            opts=(-Rns)
            $YES && opts+=(--noconfirm)
            run_pm "${opts[@]}" "${orphans[@]}"
        fi
        ;;

    update)
        run_pm -Sy
        ;;

    upgrade)
        opts=(-Su)
        $YES && opts+=(--noconfirm)
        run_pm "${opts[@]}"
        ;;

    full-upgrade)
        opts=(-Syu)
        $YES && opts+=(--noconfirm)
        run_pm "${opts[@]}"
        ;;

    clean)
        opts=(-Scc)
        $YES && opts+=(--noconfirm)
        run_pm "${opts[@]}"
        ;;

    autoclean)
        opts=(-Sc)
        $YES && opts+=(--noconfirm)
        run_pm "${opts[@]}"
        ;;

    policy)
        if [[ ${#PACKAGES[@]} -eq 0 ]]; then
            [[ -f /etc/pacman.d/mirrorlist ]] && grep '^Server' /etc/pacman.d/mirrorlist || err "mirrorlist not found"
            exit 0
        fi
        for p in "${PACKAGES[@]}"; do
            installed_ver=$(pacman -Qi "$p" 2>/dev/null | awk -F': ' '/^Version/{print $2; exit}')
            sync_info=$(pacman -Si "$p" 2>/dev/null)
            candidate_ver=$(awk -F': ' '/^Version/{print $2; exit}' <<<"$sync_info")
            repo=$(awk -F': ' '/^Repository/{print $2; exit}' <<<"$sync_info")
            echo "$p:"
            echo "  Installed: ${installed_ver:-(none)}"
            echo "  Candidate: ${candidate_ver:-(not in sync db)}"
            [[ -n "$repo" ]] && echo "  Repository: $repo"
        done
        ;;

    build)
        command -v makepkg >/dev/null 2>&1 || { err "'makepkg' not found (part of base-devel)"; exit 1; }
        [[ -f PKGBUILD ]] || { err "no PKGBUILD in the current directory"; exit 1; }
        if $SIMULATE; then
            info "[simulate] makepkg -sri"
        else
            makepkg -sri
        fi
        ;;

    rdepends)
        [[ ${#PACKAGES[@]} -eq 0 ]] && { err "rdepends requires a package name"; exit 1; }
        command -v pactree >/dev/null 2>&1 || { err "'pactree' not found (part of pacman-contrib)"; exit 1; }
        pactree -r "${PACKAGES[@]}"
        ;;

    moo)
        case "${#PACKAGES[@]}" in
            0) cat <<'EOF'
        (__)
        (oo)
  /------\/
 / |    ||
*  /\---/\
   ~~   ~~
..."Have you mooed today?"...
EOF
                ;;
            *) ok "You have found the super cow. It is amazing what one finds when going through pacman's manpage." ;;
        esac
        ;;

    edit-sources)
        local_editor="${EDITOR:-${VISUAL:-nano}}"
        command -v "$local_editor" >/dev/null 2>&1 || { err "editor '$local_editor' not found; set \$EDITOR"; exit 1; }
        target="$PACMAN_CONFIG"
        cp "$target" "${target}.aptOS.bak" 2>/dev/null
        if is_root; then
            "$local_editor" "$target"
        else
            sudo -e "$target" 2>/dev/null || sudo "$local_editor" "$target"
        fi
        if ! grep -q '^\[options\]' "$target" 2>/dev/null; then
            warn "sanity check: '[options]' section not found in $target — did you break the file? Backup saved at ${target}.aptOS.bak"
        else
            rm -f "${target}.aptOS.bak"
        fi
        info "you may also want to edit /etc/pacman.d/mirrorlist for mirror ordering."
        ;;

    log)
        # Read-only. Not a rename of apt/dnf history: pacman keeps no undo/redo
        # state, just an append-only log file.
        [[ -f /var/log/pacman.log ]] || { err "/var/log/pacman.log not found"; exit 1; }
        if [[ ${#PACKAGES[@]} -gt 0 ]]; then
            grep -i -- "${PACKAGES[0]}" /var/log/pacman.log | tail -n 50
        else
            tail -n 50 /var/log/pacman.log
        fi
        ;;

    *)
        err "unknown command '$COMMAND'"
        print_usage
        exit 1
        ;;
esac
